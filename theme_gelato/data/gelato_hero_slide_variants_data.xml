<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<data noupdate="1">

    <!-- ═══════════════════════════════════════════════════════════════
         VARIANTA V2 — krátká, úderná, faktická
         ═══════════════════════════════════════════════════════════════ -->

    <record id="hero_slide_v2_1" model="gelato.hero.slide">
        <field name="name">Gelato!</field>
        <field name="headline">To je</field>
        <field name="headline_accent">zmrzlina.</field>
        <field name="subtitle">Řemeslná gelaterie z Karlových Varů. Vlastní recepty, kvalitní suroviny, žádná chemie.</field>
        <field name="button_text">Najít nás</field>
        <field name="button_url">#pobocka</field>
        <field name="page_url">/v2</field>
        <field name="sequence">10</field>
        <field name="display_time">10.0</field>
    </record>

    <record id="hero_slide_v2_2" model="gelato.hero.slide">
        <field name="name">Vlastní recept</field>
        <field name="headline">Každá příchuť.</field>
        <field name="headline_accent">Vlastní postup.</field>
        <field name="subtitle">Pistáciová z pistácií, vanilková z pravé vanilky. Žádný univerzální základ.</field>
        <field name="button_text">Proč Gelato</field>
        <field name="button_url">#proc-gelato</field>
        <field name="page_url">/v2</field>
        <field name="sequence">20</field>
        <field name="display_time">8.0</field>
    </record>

    <record id="hero_slide_v2_3" model="gelato.hero.slide">
        <field name="name">Becherovka</field>
        <field name="headline">Hruška s Becherovkou.</field>
        <field name="headline_accent">V Itálii neexistuje.</field>
        <field name="subtitle">Karlovarský originál. Naše signature příchuť.</field>
        <field name="button_text">Kde nás najdete</field>
        <field name="button_url">#pobocka</field>
        <field name="page_url">/v2</field>
        <field name="sequence">30</field>
        <field name="display_time">8.0</field>
    </record>

    <record id="hero_slide_v2_4" model="gelato.hero.slide">
        <field name="name">Catering</field>
        <field name="headline">Přivezeme gelato</field>
        <field name="headline_accent">k vám.</field>
        <field name="subtitle">Svatby, festivaly, firemní akce. Dodávky pro restaurace a hotely.</field>
        <field name="button_text">Poptat</field>
        <field name="button_url">#poptavka</field>
        <field name="page_url">/v2</field>
        <field name="sequence">40</field>
        <field name="display_time">8.0</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         VARIANTA V3 — rodinný příběh, vypravěčský
         ═══════════════════════════════════════════════════════════════ -->

    <record id="hero_slide_v3_1" model="gelato.hero.slide">
        <field name="name">Rodinná gelaterie</field>
        <field name="headline">Chyběla nám dobrá zmrzlina.</field>
        <field name="headline_accent">Tak jsme ji začali dělat.</field>
        <field name="subtitle">Bratři Kosnarovi, Karlovy Vary. Vlastní recepty pro každou příchuť od roku jedna.</field>
        <field name="button_text">Náš příběh</field>
        <field name="button_url">#proc-gelato</field>
        <field name="page_url">/v3</field>
        <field name="sequence">10</field>
        <field name="display_time">10.0</field>
    </record>

    <record id="hero_slide_v3_2" model="gelato.hero.slide">
        <field name="name">Každý rok Rimini</field>
        <field name="headline">Učíme se u těch</field>
        <field name="headline_accent">nejlepších v Itálii.</field>
        <field name="subtitle">Sigep — největší zmrzlinový veletrh světa. Přivážíme zkušenosti, ne suvenýry.</field>
        <field name="button_text">Proč Gelato</field>
        <field name="button_url">#proc-gelato</field>
        <field name="page_url">/v3</field>
        <field name="sequence">20</field>
        <field name="display_time">8.0</field>
    </record>

    <record id="hero_slide_v3_3" model="gelato.hero.slide">
        <field name="name">Karlovarská klasika</field>
        <field name="headline">Hruška s Becherovkou.</field>
        <field name="headline_accent">Naše příchuť.</field>
        <field name="subtitle">Některé věci dávají smysl jen tady. Tuhle zmrzlinu v Římě nenajdete.</field>
        <field name="button_text">Kde nás najdete</field>
        <field name="button_url">#pobocka</field>
        <field name="page_url">/v3</field>
        <field name="sequence">30</field>
        <field name="display_time">8.0</field>
    </record>

    <record id="hero_slide_v3_4" model="gelato.hero.slide">
        <field name="name">Přivezeme k vám</field>
        <field name="headline">Vaše svatba, váš festival,</field>
        <field name="headline_accent">naše zmrzlina.</field>
        <field name="subtitle">Řekněte nám, co plánujete. Přivezeme vozík, vyberete příchutě, my se postaráme o zbytek.</field>
        <field name="button_text">Poptat catering</field>
        <field name="button_url">#poptavka</field>
        <field name="page_url">/v3</field>
        <field name="sequence">40</field>
        <field name="display_time">8.0</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         VARIANTA V4 — italský feel, řemeslný, sebevědomý
         ═══════════════════════════════════════════════════════════════ -->

    <record id="hero_slide_v4_1" model="gelato.hero.slide">
        <field name="name">Řemeslná gelaterie</field>
        <field name="headline">Tohle není točená</field>
        <field name="headline_accent">u stánku.</field>
        <field name="subtitle">Vlastní recepty. Přírodní suroviny. Italská škola, karlovarská duše. Vykřičník v názvu není náhoda.</field>
        <field name="button_text">Objevte proč</field>
        <field name="button_url">#proc-gelato</field>
        <field name="page_url">/v4</field>
        <field name="sequence">10</field>
        <field name="display_time">10.0</field>
    </record>

    <record id="hero_slide_v4_2" model="gelato.hero.slide">
        <field name="name">Italská škola</field>
        <field name="headline">Sigep, Rimini.</field>
        <field name="headline_accent">Každý rok.</field>
        <field name="subtitle">Největší zmrzlinový veletrh světa. Tam se učíme. Tady to děláme.</field>
        <field name="button_text">Proč Gelato</field>
        <field name="button_url">#proc-gelato</field>
        <field name="page_url">/v4</field>
        <field name="sequence">20</field>
        <field name="display_time">8.0</field>
    </record>

    <record id="hero_slide_v4_3" model="gelato.hero.slide">
        <field name="name">Signature příchuť</field>
        <field name="headline">Hruška. Becherovka.</field>
        <field name="headline_accent">Karlovy Vary.</field>
        <field name="subtitle">Příchuť, která dává smysl jen tady. V Římě ji nenajdete — a to je celý point.</field>
        <field name="button_text">Najít nás</field>
        <field name="button_url">#pobocka</field>
        <field name="page_url">/v4</field>
        <field name="sequence">30</field>
        <field name="display_time">8.0</field>
    </record>

    <record id="hero_slide_v4_4" model="gelato.hero.slide">
        <field name="name">Catering &amp; distribuce</field>
        <field name="headline">Gelato na vaší akci.</field>
        <field name="headline_accent">Gelato ve vašem podniku.</field>
        <field name="subtitle">Dodáváme i tam, kde na kvalitě záleží. Třeba do Grandhotelu Pupp.</field>
        <field name="button_text">Poptat catering</field>
        <field name="button_url">#poptavka</field>
        <field name="page_url">/v4</field>
        <field name="sequence">40</field>
        <field name="display_time">8.0</field>
    </record>

</data>
</odoo>
