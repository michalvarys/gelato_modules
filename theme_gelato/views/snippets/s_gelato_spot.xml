<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_gelato_spot" name="Gelato Spot">
    <section class="s_gelato_spot gl-spot theme_gelato_page pt0 pb0" data-snippet="s_gelato_spot"
             data-frame-count="256"
             data-frame-base="/theme_gelato/static/src/img/spot/frame-"
             data-auto-speed="300">
        <div class="gl-spot-sticky">
            <div class="gl-spot-stage">
                <canvas class="gl-spot-canvas"></canvas>
                <div class="gl-spot-shade"></div>

                <div class="gl-spot-caption" data-from="0.05" data-to="0.30">
                    <div class="gl-spot-badge">Vlastní receptura</div>
                    <h2>Co dělá zmrzlinu<br/><span>zmrzlinou.</span></h2>
                </div>
                <div class="gl-spot-caption" data-from="0.38" data-to="0.62">
                    <div class="gl-spot-badge">Přírodní suroviny</div>
                    <h2>Žádné stabilizátory,<br/><span>žádná barviva.</span></h2>
                </div>
                <div class="gl-spot-caption" data-from="0.72" data-to="0.95">
                    <div class="gl-spot-badge">Navštivte nás</div>
                    <h2>Tři místa,<br/><span>jedna zmrzlina.</span></h2>
                </div>

                <div class="gl-spot-loader">
                    <div class="gl-spot-loader-bar"><i></i></div>
                    <small>Načítáme</small>
                </div>
            </div>
            <div class="gl-spot-progress"><i></i></div>
        </div>
    </section>
</template>
</odoo>
