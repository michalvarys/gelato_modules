<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Body class injection -->
<template id="layout_body_class" inherit_id="website.layout" name="Gelato Body Class" active="True">
    <xpath expr="//body" position="attributes">
        <attribute name="class" add="theme_gelato_body" separator=" "/>
    </xpath>
</template>

<!-- Header override - inject Google Fonts -->
<template id="layout_header" inherit_id="website.layout" name="Gelato Header" active="True">
    <xpath expr="//head" position="inside">
        <style>.gl-hero:not(.gl-loaded){visibility:hidden!important}body.theme_gelato_body{background:#1a1a1a!important}</style>
        <link rel="preload" href="/theme_gelato/static/src/img/iscream-white.webp" as="image" type="image/webp"/>
        <link rel="preload" href="/theme_gelato/static/src/img/gelato-logo-white.svg" as="image" type="image/svg+xml"/>
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&amp;family=Kalnia:wght@400;700&amp;display=swap" rel="stylesheet"/>
    </xpath>
</template>

<!-- Loading screen - prepended so it renders before any JS -->
<template id="layout_loader" inherit_id="website.layout" name="Gelato Loader" active="True">
    <xpath expr="//body/*[1]" position="before">
        <div t-if="not request.params.get('form')" id="gl-loader" class="gl-loader" style="position:fixed;inset:0;z-index:99999;background:#1a1a1a;display:flex;align-items:center;justify-content:center">
            <div style="display:flex;flex-direction:column;align-items:center;gap:16px">
                <img src="/theme_gelato/static/src/img/iscream-white.webp"
                     alt="" class="gl-loader-img"
                     width="768" height="512"/>
                <img src="/theme_gelato/static/src/img/gelato-logo-white.svg"
                     alt="Gelato!" class="gl-loader-brand" width="472" height="146"/>
            </div>
        </div>
    </xpath>
</template>

<!-- LocalBusiness structured data (SEO/GEO) -->
<template id="layout_ldjson" inherit_id="website.layout" name="Gelato LocalBusiness Schema" active="True">
    <xpath expr="//head" position="inside">
        <script type="application/ld+json">{
            "@context": "https://schema.org",
            "@type": "IceCreamShop",
            "name": "Gelato! Karlovy Vary",
            "url": "https://www.gelatokv.cz",
            "image": "https://www.gelatokv.cz/theme_gelato/static/src/img/gelato-logo-white.svg",
            "telephone": "+420773095809",
            "email": "gelatokv@seznam.cz",
            "address": {
                "@type": "PostalAddress",
                "streetAddress": "Sokolovská 101",
                "addressLocality": "Karlovy Vary",
                "postalCode": "360 05",
                "addressCountry": "CZ"
            },
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": 50.2339,
                "longitude": 12.8546
            },
            "openingHoursSpecification": [{
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
                "opens": "11:00",
                "closes": "20:00"
            }],
            "sameAs": [
                "https://instagram.com/gelatokarlovyvary",
                "https://facebook.com/gelatokarlovyvary"
            ],
            "servesCuisine": "Gelato"
        }</script>
    </xpath>
</template>

<!-- Mobile nav drawer: Gelato! logo above the menu links -->
<template id="header_mobile_logo" inherit_id="website.template_header_mobile" name="Gelato Mobile Nav Logo" active="True">
    <xpath expr="//div[@id='top_menu_collapse_mobile']/div[hasclass('offcanvas-header')]" position="after">
        <div class="gl-mobile-nav-logo o_not_editable">
            <a href="/">
                <img src="/theme_gelato/static/src/img/gelato-logo-white.svg" alt="Gelato!" width="472" height="146" loading="lazy"/>
            </a>
        </div>
    </xpath>
    <xpath expr="//div[@id='top_menu_collapse_mobile']/div[hasclass('offcanvas-body')]" position="inside">
        <div class="gl-mobile-nav-contact o_not_editable">
            <a href="tel:+420773095809">
                <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                +420 773 09 58 09
            </a>
            <a href="mailto:gelatokv@seznam.cz">
                <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                gelatokv@seznam.cz
            </a>
            <span class="gl-mobile-nav-hours">Po&#8211;Ne 11:00&#8211;20:00</span>
        </div>
    </xpath>
</template>

