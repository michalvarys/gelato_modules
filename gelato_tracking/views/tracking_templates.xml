<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The tracking snippets go after #wrapwrap, the same place Odoo itself
        uses for Google Analytics. The "not editable" condition matters:
        nothing is measured inside the website editor, so editing pages does
        not pollute the statistics.

        Watch the XML: every & must be written as &amp; or the template will
        not save.
    -->
    <template id="gelato_tracking_layout" inherit_id="website.layout" name="Gelato: tracking snippets">
        <xpath expr="//div[@id='wrapwrap']" position="after">

            <!-- ═══════════ Google Tag Manager ═══════════ -->
            <t t-if="website.gelato_gtm_id and not editable">
                <script id="gelato_gtm">
                    (function(w,d,s,l,i){
                        w[l]=w[l]||[];
                        w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
                        var f=d.getElementsByTagName(s)[0],
                            j=d.createElement(s),
                            dl=l!='dataLayer'?'&amp;l='+l:'';
                        j.async=true;
                        j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
                        f.parentNode.insertBefore(j,f);
                    })(window,document,'script','dataLayer','<t t-esc="website.gelato_gtm_id"/>');
                </script>
                <noscript>
                    <iframe height="0" width="0" style="display:none;visibility:hidden"
                            t-attf-src="https://www.googletagmanager.com/ns.html?id=#{website.gelato_gtm_id}"/>
                </noscript>
            </t>

            <!-- ═══════════ Meta Pixel ═══════════ -->
            <t t-if="website.gelato_meta_pixel_id and not editable">
                <script id="gelato_meta_pixel">
                    !function(f,b,e,v,n,t,s){
                        if(f.fbq)return;
                        n=f.fbq=function(){
                            n.callMethod ? n.callMethod.apply(n,arguments) : n.queue.push(arguments)
                        };
                        if(!f._fbq)f._fbq=n;
                        n.push=n; n.loaded=!0; n.version='2.0'; n.queue=[];
                        t=b.createElement(e); t.async=!0;
                        t.src=v;
                        s=b.getElementsByTagName(e)[0];
                        s.parentNode.insertBefore(t,s);
                    }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
                    fbq('init', '<t t-esc="website.gelato_meta_pixel_id"/>');
                    fbq('track', 'PageView');
                </script>
                <noscript>
                    <img height="1" width="1" style="display:none" alt=""
                         t-attf-src="https://www.facebook.com/tr?id=#{website.gelato_meta_pixel_id}&amp;ev=PageView&amp;noscript=1"/>
                </noscript>
            </t>

        </xpath>
    </template>

</odoo>
