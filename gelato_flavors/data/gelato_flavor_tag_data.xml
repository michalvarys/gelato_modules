<?xml version="1.0" encoding="utf-8"?>
<!--
    Starting set of tags. They are only a starting point - the shop renames
    them and adds its own (no added sugar, new, bio...) straight in Odoo.
-->
<odoo noupdate="1">

    <record id="tag_vegan" model="gelato.flavor.tag">
        <field name="name">vegan</field>
        <field name="color">#84c5c3</field>
        <field name="sequence">10</field>
    </record>

    <record id="tag_lactose_free" model="gelato.flavor.tag">
        <field name="name">lactose free</field>
        <field name="color">#84c5c3</field>
        <field name="sequence">20</field>
    </record>

    <record id="tag_alcohol" model="gelato.flavor.tag">
        <field name="name">with alcohol</field>
        <field name="color">#e8b06a</field>
        <field name="sequence">30</field>
    </record>

</odoo>
