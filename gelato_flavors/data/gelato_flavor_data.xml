<?xml version="1.0" encoding="utf-8"?>
<!--
    Default flavour list, based on the menu at gelatokv.cz.

    noupdate="1" means a module upgrade will not overwrite these records. The
    staff can rename, switch or archive them and an upgrade will not undo that.

    available="True" is deliberate: right after installation the website has
    something to show. The staff then switch off whatever was not mixed.
-->
<odoo noupdate="1">

    <record id="flavor_pistacie" model="gelato.flavor">
        <field name="name">Pistachio</field>
        <field name="description">Roasted Sicilian pistachios, no colourings.</field>
        <field name="category_id" ref="category_zmrzliny"/>
        <field name="sequence">10</field>
        <field name="available" eval="True"/>
        <field name="allergens">nuts, milk</field>
        <field name="color">#9cb86f</field>
    </record>

    <record id="flavor_slany_karamel" model="gelato.flavor">
        <field name="name">Salted caramel</field>
        <field name="description">Slow-cooked caramel with flaky salt.</field>
        <field name="category_id" ref="category_zmrzliny"/>
        <field name="sequence">20</field>
        <field name="available" eval="True"/>
        <field name="allergens">milk</field>
        <field name="color">#c98b4b</field>
    </record>

    <record id="flavor_slany_arasid" model="gelato.flavor">
        <field name="name">Salted peanut</field>
