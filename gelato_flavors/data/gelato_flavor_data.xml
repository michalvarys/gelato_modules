    <!-- Out of season. Switched off after installation. -->
    <record id="flavor_vajecnak" model="gelato.flavor">
        <field name="name">Eggnog</field>
        <field name="description">A winter classic with real egg liqueur.</field>
        <field name="category_id" ref="category_sezonni"/>
        <field name="sequence">200</field>
