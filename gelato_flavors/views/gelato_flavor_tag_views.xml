<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gelato_flavor_tag_view_list" model="ir.ui.view">
        <field name="name">gelato.flavor.tag.list</field>
        <field name="model">gelato.flavor.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="gelato_color"/>
                <field name="flavor_count" string="Flavours"/>
            </list>
        </field>
    </record>

    <record id="gelato_flavor_tag_view_form" model="ir.ui.view">
        <field name="name">gelato.flavor.tag.form</field>
        <field name="model">gelato.flavor.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="For example vegan"/>
                        </h1>
                    </div>
                    <group>
                        <field name="color" widget="gelato_color"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <div class="alert alert-info" role="status">
                        Renaming a tag changes it on every flavour that carries it,
                        and on the website straight away.
                    </div>
                    <notebook>
                        <page string="Flavours with this tag" name="flavors">
                            <field name="flavor_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="available" widget="boolean_toggle" string="Today"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gelato_flavor_tag_action" model="ir.actions.act_window">
        <field name="name">Flavour tags</field>
        <field name="res_model">gelato.flavor.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Create your first tag.</p>
            <p>Tags are the small badges next to a flavour on the website - vegan, lactose free, no added sugar. You choose what they say.</p>
        </field>
    </record>

</odoo>
