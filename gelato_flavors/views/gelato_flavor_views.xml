<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         The board for the shop staff: big tiles, one click flips a flavour
         ============================================================ -->
    <record id="gelato_flavor_view_kanban" model="ir.ui.view">
        <field name="name">gelato.flavor.kanban</field>
        <field name="model">gelato.flavor</field>
        <field name="arch" type="xml">
            <!-- records_draggable: dragging a tile into another column moves the
                 flavour to that category, and dragging inside a column reorders
                 it (that is what the sequence field is for). Odoo writes both
                 itself, no extra code needed.

                 default_order puts whatever is being scooped today at the
                 top of its category. What is switched off stays underneath
                 rather than disappearing - come the afternoon somebody has
                 to switch it back on. -->
            <kanban class="o_gelato_board" records_draggable="true" can_open="false" create="0"
                    default_order="available desc, sequence, name">
                <field name="available"/>
                <field name="display_color"/>
                <templates>
                    <t t-name="card">
                        <div class="o_gelato_tile" t-attf-class="#{record.available.raw_value ? 'o_gelato_on' : 'o_gelato_off'}">
                            <!-- The dot is the colour picker. On a phone Odoo
                                 always opens this board instead of the list,
                                 so a colour that lived only in the list could
                                 not be changed from a phone at all.

                                 The "dropdown" class is not decoration. Tiles
                                 can be dragged to reorder them, and on a touch
                                 screen that drag swallowed the tap before the
                                 colour dialog could open - it worked with a
                                 mouse and did nothing on a phone. Odoo skips
                                 the drag for anything inside ".dropdown,select"
                                 (kanban_renderer.js), and that is the only
                                 hook a view has to say "not here". -->
                            <span class="dropdown o_gelato_tile_dot_slot">
                                <field name="color" widget="gelato_color" class="o_gelato_tile_dot"
                                       options="{'autosave': true}"/>
                            </span>
                            <div class="o_gelato_tile_body">
                                <div class="o_gelato_tile_name">
                                    <field name="name"/>
                                </div>
                                <div class="o_gelato_tile_cat">
                                    <field name="category_id"/>
                                </div>
                            </div>
                            <div class="o_gelato_tile_switch">
                                <field name="available" widget="boolean_toggle" nolabel="1"/>
                                <span class="o_gelato_tile_state">
                                    <span t-if="record.available.raw_value">Mixing today</span>
                                    <span t-else="">Switched off</span>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================
         List - the switch sits in the very first column
         ============================================================ -->
    <record id="gelato_flavor_view_list" model="ir.ui.view">
        <field name="name">gelato.flavor.list</field>
        <field name="model">gelato.flavor</field>
        <field name="arch" type="xml">
            <list string="Flavours" editable="bottom" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="available" widget="boolean_toggle" string="On the menu today"/>
                <field name="name"/>
                <field name="category_id"/>
                <!-- Right here in the list, because the list edits in place:
                     clicking a flavour never opens its form, so a colour that
                     lived only there could not be reached at all. And all the
                     dots side by side is how you tell whether they go
                     together. -->
                <field name="color" widget="gelato_color" optional="show"/>
                <field name="description" optional="show"/>
                <field name="allergens" optional="hide"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="available_since" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Form
         ============================================================ -->
    <record id="gelato_flavor_view_form" model="ir.ui.view">
        <field name="name">gelato.flavor.form</field>
        <field name="model">gelato.flavor</field>
        <field name="arch" type="xml">
            <form string="Flavour">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="For example Salted caramel"/>
                        </h1>
                        <field name="description" placeholder="One sentence for the website..."/>
                    </div>
                    <div class="o_row mt-3">
                        <field name="available" widget="boolean_toggle"/>
                        <label for="available" string="On the menu today"/>
                    </div>
                    <group>
                        <group string="Filing">
                            <field name="category_id"/>
                            <field name="sequence"/>
                            <field name="color" widget="gelato_color"/>
                            <!-- What the customer actually sees. A flavour
                                 with no colour of its own borrows the
                                 category's, and the picker above cannot show
                                 that - an empty colour looks black in it. -->
                            <field name="display_color" widget="color" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="For customers">
                            <field name="tag_ids" widget="many2many_tags" placeholder="vegan, lactose free..."/>
                            <field name="allergens" placeholder="nuts, milk"/>
                            <field name="available_since"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Search and filters
         ============================================================ -->
    <record id="gelato_flavor_view_search" model="ir.ui.view">
        <field name="name">gelato.flavor.search</field>
        <field name="model">gelato.flavor</field>
        <field name="arch" type="xml">
            <search string="Flavours">
                <field name="name"/>
                <field name="category_id"/>
                <field name="tag_ids"/>
                <filter name="filter_available" string="On the menu today" domain="[('available', '=', True)]"/>
                <filter name="filter_unavailable" string="Switched off" domain="[('available', '=', False)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_available" string="On the menu today" context="{'group_by': 'available'}"/>
                    <filter name="group_tag" string="Tag" context="{'group_by': 'tag_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         Actions
         ============================================================ -->
    <record id="gelato_flavor_action_board" model="ir.actions.act_window">
        <field name="name">Today's menu</field>
        <field name="res_model">gelato.flavor</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">There are no flavours yet.</p>
            <p>Flavours are created by the manager under <b>Flavours</b>. Here you only switch what was mixed today.</p>
        </field>
    </record>

    <record id="gelato_flavor_action_all" model="ir.actions.act_window">
        <field name="name">Flavours</field>
        <field name="res_model">gelato.flavor</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Create your first flavour.</p>
            <p>The flavour list can be extended at any time. Do not delete a flavour you no longer make - archive it instead.</p>
        </field>
    </record>

    <record id="gelato_flavor_action_turn_all_off" model="ir.actions.server">
        <field name="name">Switch all flavours off</field>
        <field name="model_id" ref="model_gelato_flavor"/>
        <field name="binding_model_id" ref="model_gelato_flavor"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = model.action_turn_all_off()</field>
    </record>

</odoo>
