<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gelato_flavor_category_view_list" model="ir.ui.view">
        <field name="name">gelato.flavor.category.list</field>
        <field name="model">gelato.flavor.category</field>
        <field name="arch" type="xml">
            <list string="Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="gelato_color"/>
                <field name="flavor_count" string="Flavours"/>
            </list>
        </field>
    </record>

    <record id="gelato_flavor_category_view_form" model="ir.ui.view">
        <field name="name">gelato.flavor.category.form</field>
        <field name="model">gelato.flavor.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="For example Sorbets"/>
                        </h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="color" widget="gelato_color"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Flavours" name="flavors">
                            <field name="flavor_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="available" widget="boolean_toggle" string="Today"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gelato_flavor_category_action" model="ir.actions.act_window">
        <field name="name">Flavour categories</field>
        <field name="res_model">gelato.flavor.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Create your first category.</p>
            <p>Categories only sort the flavours on the website - for example Ice creams, Sorbets, Vegan.</p>
        </field>
    </record>

</odoo>
