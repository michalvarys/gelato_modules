<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_gelato" model="ir.module.category">
        <field name="name">Delivery</field>
        <field name="description">Managing the gelato menu and deliveries.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_gelato_staff" model="res.groups">
        <field name="name">Shop staff</field>
        <field name="category_id" ref="module_category_gelato"/>
        <field name="comment">Can switch which flavours are on the menu today.</field>
    </record>

    <record id="group_gelato_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_gelato"/>
        <field name="implied_ids" eval="[(4, ref('group_gelato_staff'))]"/>
        <field name="comment">Can also create, edit and delete flavours and categories.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
