<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        A single database can host several websites. An order belongs to the
        website it came from - without this rule the staff of another website
        in the same database would see it too.

        Orders entered by hand (with no website) are visible to everyone.
    -->
    <record id="gelato_delivery_order_website_rule" model="ir.rule">
        <field name="name">Delivery orders: own website only</field>
        <field name="model_id" ref="model_gelato_delivery_order"/>
        <field name="domain_force">['|', ('website_id', '=', False), ('website_id.company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
