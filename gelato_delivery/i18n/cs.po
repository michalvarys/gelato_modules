#. module: gelato_delivery
#: model:mail.template,body_html:gelato_delivery.mail_template_order_confirmation
msgid ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;\">\n"
"                <p>Hello <t t-out=\"object.customer_name\">Jan Novak</t>,</p>\n"
"                <p>thank you for your order. We are getting it ready and driving out.</p>\n"
"                <table cellpadding=\"4\" style=\"border-collapse: collapse;\">\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Order number</td>\n"
"                        <td><strong t-out=\"object.name\">ROZ/2026/0001</strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Ordered</td>\n"
"                        <td>\n"
"                            <t t-foreach=\"object.item_ids\" t-as=\"line\">\n"
"                                <div>\n"
"                                    <span t-if=\"line.quantity &gt; 1\"><t t-out=\"line.quantity\">2</t>× </span>\n"
"                                    <strong t-out=\"line.box_id.name or line.addon_id.name\">1 l</strong>\n"
"                                    <span t-if=\"line.flavor_line_ids\" style=\"color: #666;\">\n"
"                                        – <t t-out=\"line.flavor_names()\">Pistachio</t>\n"
"                                    </span>\n"
"                                </div>\n"
"                            </t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Delivery to</td>\n"
"                        <td t-out=\"object.delivery_address\">Sokolovská 101</td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Total</td>\n"
"                        <td><strong><t t-out=\"int(object.amount_total)\">529</t> Kč</strong></td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>You pay in cash when we hand it over. Nothing up front.</p>\n"
"                <p>\n"
"                    Gelato! Karlovy Vary<br/>\n"
"                    Sokolovská 101, Rybáře · +420 773 09 58 09\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 15px; color: #1a1a1a;\">\n"
"    <h2 style=\"margin: 0 0 4px; font-size: 20px;\">Máme vaši objednávku!</h2>\n"
"    <p style=\"margin: 0 0 18px; color: #555;\">\n"
"        Děkujeme. Ozveme se vám a doručení potvrdíme. Platí se hotově při předání.\n"
"    </p>\n"
"\n"
"    <table cellpadding=\"4\" style=\"border-collapse: collapse;\">\n"
"        <tr>\n"
"            <td style=\"color: #666;\">Číslo objednávky</td>\n"
"            <td><strong t-out=\"object.name\">ROZ/2026/0001</strong></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"color: #666;\">Objednali jste si</td>\n"
"            <td>\n"
"                <t t-foreach=\"object.item_ids\" t-as=\"line\">\n"
"                    <div>\n"
"                        <span t-if=\"line.quantity &gt; 1\"><t t-out=\"line.quantity\">2</t>× </span>\n"
"                        <strong t-out=\"line.box_id.name or line.addon_id.name\">1 l</strong>\n"
"                        <span t-if=\"line.flavor_line_ids\" style=\"color: #666;\">\n"
"                            – <t t-out=\"line.flavor_names()\">Pistácie</t>\n"
"                        </span>\n"
"                    </div>\n"
"                </t>\n"
"            </td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"color: #666;\">Doručíme na</td>\n"
"            <td t-out=\"object.delivery_address\">Sokolovská 101</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"color: #666;\">Celkem</td>\n"
"            <td><strong><t t-out=\"int(object.amount_total)\">529</t> Kč</strong></td>\n"
"        </tr>\n"
"    </table>\n"
"\n"
"    <p style=\"margin-top: 18px; color: #555;\">\n"
"        Potřebujete něco změnit? Zavolejte nám na\n"
"        <a href=\"tel:+420773095809\">+420 773 09 58 09</a>.\n"
"    </p>\n"
"</div>"

#. module: gelato_delivery
#: model_terms:ir.actions.act_window,help:gelato_delivery.gelato_delivery_bundle_action
msgid "A bundle is a thermal box and a bottle together for one better price. It shows in the <b>Bundles at a better price</b> row on the delivery page, and the customer fills it with flavours just like a box."
msgstr "Balíček je termobox a láhev dohromady za jednu výhodnější cenu. Na stránce rozvozu se ukazuje v řadě <b>Zvýhodněné balíčky</b> a zákazník si ho plní příchutěmi stejně jako box."

#. module: gelato_delivery
#: model:ir.model.constraint,message:gelato_delivery.constraint_gelato_delivery_order_flavor_flavor_once_per_item
msgid "A flavour can only be in one box once - raise its count instead of adding it twice."
msgstr "Stejná příchuť může být v jednom boxu jen jednou – místo druhého přidání jí zvyšte počet."

#. module: gelato_delivery
#: model_terms:ir.actions.act_window,help:gelato_delivery.gelato_delivery_addon_action
msgid "An extra is a bottle of prosecco or anything else that goes into an order on its own, with no flavours to pick. It shows in the <b>Extras</b> row on the delivery page. The <b>Available</b> switch turns it on and off."
msgstr "Doplněk je láhev prosecca nebo cokoliv dalšího, co jde do objednávky samo o sobě a nevybírají se k tomu příchutě. Na stránce rozvozu se ukazuje v řadě <b>Doplňky</b>. Přepínač <b>V nabídce</b> ho zapíná a vypíná."

#. module: gelato_delivery
#: model:ir.model.constraint,message:gelato_delivery.constraint_gelato_delivery_order_item_box_or_addon
msgid "An item is either a thermal box or a bundle/extra, not both and not neither."
msgstr "Položka je buď termobox, nebo balíček či doplněk – ne obojí a ne nic."

#. module: gelato_delivery
#: model:ir.model.constraint,message:gelato_delivery.constraint_gelato_delivery_order_item_quantity_positive
msgid "An item with no quantity does not belong on the order."
msgstr "Položka bez množství na objednávku nepatří."

#. module: gelato_delivery
#: model_terms:ir.actions.act_window,help:gelato_delivery.gelato_delivery_bundle_action
msgid "Create your first bundle."
msgstr "Založte první balíček."

#. module: gelato_delivery
#: model:ir.model.fields,help:gelato_delivery.field_gelato_delivery_order__flavor_line_ids
msgid "Every flavour in the order, across all the boxes. Filled in through the items."
msgstr "Všechny příchutě v objednávce napříč všemi boxy. Plní se přes položky."

