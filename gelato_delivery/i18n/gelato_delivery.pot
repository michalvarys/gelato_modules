#. module: gelato_delivery
#: model:mail.template,body_html:gelato_delivery.mail_template_order_confirmation
msgid ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;\">\n"
"                <p>Hello <t t-out=\"object.customer_name\">Jan Novak</t>,</p>\n"
"                <p>thank you for your order. We are getting it ready and driving out.</p>\n"
"                <table cellpadding=\"4\" style=\"border-collapse: collapse;\">\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Order number</td>\n"
"                        <td><strong t-out=\"object.name\">ROZ/2026/0001</strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Ordered</td>\n"
"                        <td>\n"
"                            <t t-foreach=\"object.item_ids\" t-as=\"line\">\n"
"                                <div>\n"
"                                    <span t-if=\"line.quantity &gt; 1\"><t t-out=\"line.quantity\">2</t>× </span>\n"
"                                    <strong t-out=\"line.box_id.name or line.addon_id.name\">1 l</strong>\n"
"                                    <span t-if=\"line.flavor_line_ids\" style=\"color: #666;\">\n"
"                                        – <t t-out=\"line.flavor_names()\">Pistachio</t>\n"
"                                    </span>\n"
"                                </div>\n"
"                            </t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Delivery to</td>\n"
"                        <td t-out=\"object.delivery_address\">Sokolovská 101</td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Total</td>\n"
"                        <td><strong><t t-out=\"int(object.amount_total)\">529</t> Kč</strong></td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>You pay in cash when we hand it over. Nothing up front.</p>\n"
"                <p>\n"
"                    Gelato! Karlovy Vary<br/>\n"
"                    Sokolovská 101, Rybáře · +420 773 09 58 09\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: gelato_delivery
#: model:mail.template,body_html:gelato_delivery.mail_template_delivery_order
msgid ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 15px; color: #1a1a1a;\">\n"
"                <h2 style=\"margin: 0 0 4px; font-size: 20px;\">\n"
"                    New order <span t-out=\"object.name\">ROZ/2026/0001</span>\n"
"                </h2>\n"
"\n"
"                <table cellpadding=\"6\" style=\"border-collapse: collapse; margin-top: 16px; width: 100%; max-width: 480px;\">\n"
"                    <tr t-foreach=\"object.item_ids\" t-as=\"line\">\n"
"                        <td style=\"border-bottom: 1px solid #ddd;\">\n"
"                            <span t-if=\"line.quantity &gt; 1\"><t t-out=\"line.quantity\">2</t>× </span>\n"
"                            <strong t-out=\"line.box_id.name or line.addon_id.name\">1 l</strong>\n"
"                            <br t-if=\"line.flavor_line_ids\"/>\n"
"                            <span t-if=\"line.flavor_line_ids\" style=\"color: #666;\" t-out=\"line.flavor_names()\">Pistachio</span>\n"
"                        </td>\n"
"                        <td style=\"border-bottom: 1px solid #ddd; text-align: right; white-space: nowrap;\">\n"
"                            <strong><t t-out=\"int(line.price_subtotal)\">450</t> Kč</strong>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr t-if=\"object.amount_discount\">\n"
"                        <td style=\"border-bottom: 1px solid #ddd;\">Discount</td>\n"
"                        <td style=\"border-bottom: 1px solid #ddd; text-align: right; white-space: nowrap;\">\n"
"                            −<t t-out=\"int(object.amount_discount)\">0</t> Kč\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"border-bottom: 1px solid #ddd;\">Delivery</td>\n"
"                        <td style=\"border-bottom: 1px solid #ddd; text-align: right; white-space: nowrap;\">\n"
"                            <t t-out=\"int(object.delivery_fee)\">79</t> Kč\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"font-size: 17px; padding-top: 10px;\"><strong>Total</strong></td>\n"
"                        <td style=\"font-size: 17px; padding-top: 10px; text-align: right; white-space: nowrap;\">\n"
"                            <strong><t t-out=\"int(object.amount_total)\">529</t> Kč</strong>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <h3 style=\"margin: 24px 0 6px; font-size: 16px;\">Where and to whom</h3>\n"
"                <table cellpadding=\"4\" style=\"border-collapse: collapse;\">\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Address</td>\n"
"                        <td><strong t-out=\"object.delivery_address\">Sokolovská 101</strong></td>\n"
"                    </tr>\n"
"                    <tr t-if=\"object.delivery_postcode\">\n"
"                        <td style=\"color: #666;\">Postcode</td>\n"
"                        <td t-out=\"object.delivery_postcode\">360 05</td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Name</td>\n"
"                        <td><strong t-out=\"object.customer_name\">Jan Novák</strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Phone</td>\n"
"                        <td><strong t-out=\"object.customer_phone\">+420 000 000 000</strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Email</td>\n"
"                        <td t-out=\"object.customer_email\">jan@email.cz</td>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <p t-if=\"object.note\" style=\"margin-top: 18px; padding: 10px; background: #fdf4e3;\">\n"
"                    <strong>Note from the customer:</strong>\n"
"                    <span t-out=\"object.note\">Ring the bell marked Novák</span>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

