<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gelato_promo_code_view_list" model="ir.ui.view">
        <field name="name">gelato.promo.code.list</field>
        <field name="model">gelato.promo.code</field>
        <field name="arch" type="xml">
            <!-- Not editable in place: the discount now has a scope and
                 a product list behind it, and those belong on the form. -->
            <list string="Promo codes">
                <field name="active" widget="boolean_toggle" string="Valid"/>
                <field name="code"/>
                <field name="discount_percent"/>
                <field name="scope_label" string="What it does"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="usage_count" string="Used"/>
                <field name="usage_limit" string="Limit"/>
                <field name="description" optional="show"/>
            </list>
        </field>
    </record>

    <record id="gelato_promo_code_view_form" model="ir.ui.view">
        <field name="name">gelato.promo.code.form</field>
        <field name="model">gelato.promo.code</field>
        <field name="arch" type="xml">
            <form string="Promo code">
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1>
                            <field name="code" placeholder="ZIMA10"/>
                        </h1>
                        <field name="description" placeholder="What the code is for..."/>
                    </div>
                    <div class="o_row mt-3">
                        <field name="active" widget="boolean_toggle"/>
                        <label for="active" string="The code is currently valid"/>
                    </div>
                    <group>
                        <group string="Discount">
                            <field name="discount_percent"/>
                            <field name="scope" widget="radio"/>
                            <field name="box_ids" widget="many2many_tags"
                                   invisible="scope != 'products'"
                                   options="{'no_create': True}"/>
                            <field name="addon_ids" widget="many2many_tags"
                                   invisible="scope != 'products'"
                                   options="{'no_create': True}"/>
                            <field name="scope_label" readonly="1"/>
                        </group>
                        <group string="Validity">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="How many times it may be used">
                            <field name="usage_limit"/>
                            <field name="usage_count"/>
                            <field name="usage_left" invisible="not usage_limit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Orders using this code" name="orders">
                            <field name="order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="delivery_date"/>
                                    <field name="customer_name"/>
                                    <field name="amount_discount" string="Discount"/>
                                    <field name="amount_total" string="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gelato_promo_code_view_search" model="ir.ui.view">
        <field name="name">gelato.promo.code.search</field>
        <field name="model">gelato.promo.code</field>
        <field name="arch" type="xml">
            <search string="Promo codes">
                <field name="code"/>
                <filter name="filter_active" string="Valid" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Switched off" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="gelato_promo_code_action" model="ir.actions.act_window">
        <field name="name">Promo codes</field>
        <field name="res_model">gelato.promo.code</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Create your first promo code.</p>
            <p>The customer types the code into the delivery form. The website checks it against this list and works out the discount itself.</p>
        </field>
    </record>

</odoo>
