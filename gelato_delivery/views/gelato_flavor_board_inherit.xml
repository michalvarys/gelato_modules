<?xml version="1.0" encoding="utf-8"?>
<!--
    The flavour board belongs to the Flavours module, but the delivery switch
    belongs here. This hangs the custom kanban class on that board, which is
    what puts the on/off bar above the tiles.
-->
<odoo>

    <record id="gelato_flavor_view_kanban_delivery_switch" model="ir.ui.view">
        <field name="name">gelato.flavor.kanban.delivery.switch</field>
        <field name="model">gelato.flavor</field>
        <field name="inherit_id" ref="gelato_flavors.gelato_flavor_view_kanban"/>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="js_class">gelato_delivery_board</attribute>
            </kanban>
        </field>
    </record>

</odoo>
