<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gelato_delivery_zone_view_list" model="ir.ui.view">
        <field name="name">gelato.delivery.zone.list</field>
        <field name="model">gelato.delivery.zone</field>
        <field name="arch" type="xml">
            <list string="Delivery zones">
                <field name="sequence" widget="handle"/>
                <field name="active" widget="boolean_toggle" string="We deliver"/>
                <field name="name"/>
                <field name="delivery_fee" string="Delivery fee"/>
                <field name="free_from" string="Free from"/>
                <field name="min_order" string="Minimum order" optional="hide"/>
                <field name="point_count" string="Corners"/>
                <field name="color" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="gelato_delivery_zone_view_form" model="ir.ui.view">
        <field name="name">gelato.delivery.zone.form</field>
        <field name="model">gelato.delivery.zone</field>
        <field name="arch" type="xml">
            <form string="Delivery zone">
                <sheet>
                    <widget name="web_ribbon" title="We do not deliver here"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="For example Centre"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Price">
                            <field name="delivery_fee"/>
                            <field name="free_from"/>
                            <field name="min_order"/>
                        </group>
                        <group string="Zone">
                            <field name="sequence"/>
                            <field name="color" widget="gelato_color"/>
                            <field name="active" invisible="1"/>
                            <field name="point_count" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        The customer's address is put on the map and whichever zone
                        it lands in sets the delivery fee. An address that lands in
                        <b>no</b> zone is refused with a note to call you.
                        <br/>
                        Zones may overlap - the one higher in the list wins, so a
                        small cheap zone can sit inside a big expensive one.
                        <br/>
                        <b>No zones at all means no checking</b> - every address
                        goes through and pays the fee from the settings.
                    </div>
                    <group string="Map">
                        <field name="polygon" widget="gelato_zone_map" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gelato_delivery_zone_action" model="ir.actions.act_window">
        <field name="name">Delivery zones</field>
        <field name="res_model">gelato.delivery.zone</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">No zones drawn yet.</p>
            <p>Draw the part of town you deliver to and give it a price. While there are no zones, every address goes through.</p>
        </field>
    </record>

</odoo>
