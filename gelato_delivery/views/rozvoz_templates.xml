<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         The delivery page.

         Everything on offer is shown once and picked in the same place.
         There used to be a showcase at the top and a second set of
         checkboxes in the form below, which meant every flavour, box and
         extra appeared on the page twice.

         An order is for now. No date, no time slot: the customer orders,
         the gelateria makes it and drives out.
         ============================================================ -->
    <template id="rozvoz" name="Gelato: Delivery">
        <t t-call="website.layout">
            <t t-set="additional_title">Gelato and prosecco delivery in Karlovy Vary</t>

            <div id="wrap" class="oe_structure oe_empty gl-page">

                <!-- ═══════════ HERO ═══════════
                     The same hero as the front page. The pictures and the
                     wording come from the slides in the back office, so the
                     gelateria changes them itself: add a slide and write
                     /rozvoz under "Only on these addresses". Nothing else
                     stands between it and the order. -->
                <section class="s_gelato_hero gl-hero o_cc o_cc5 theme_gelato_page pt0 pb0 gl-hero-rozvoz"
                         id="hero" data-gl-interval="6000">
                    <div class="gl-hero-bg" contenteditable="false"></div>
                    <div class="gl-hero-overlay"></div>
                    <div class="gl-hero-grain"></div>

                    <div class="gl-hero-inner">
                        <div class="gl-hero-logos">
                            <img src="/theme_gelato/static/src/img/fabrica-gelato-white.png"
                                 alt="Fabrica Gelato" class="gl-hero-fabrica"/>
                            <img src="/theme_gelato/static/src/img/gelato-logo-white.svg"
                                 alt="Gelato!" class="gl-hero-logo" width="472" height="146"/>
                        </div>
                        <div class="gl-hero-slides-wrap" contenteditable="false"></div>
                    </div>

                    <div class="gl-hero-slide-nav" contenteditable="false" id="heroSlideNav"></div>
                </section>

                <!-- ═══════════ ORDER: everything is picked here ═══════════ -->
                <section class="gl-rz-sec gl-rz-dark gl-rz-order" id="objednavka">
                    <div class="container">
                        <!-- The invitation only belongs above something you
                             can actually order from. With the delivery shut
                             it read as an offer and then took it away in the
                             next breath, so it goes with the products. -->
                        <div class="gl-rz-head" t-if="orders_open">
                            <h2>Put together your <span>box</span>.</h2>
                            <p>The order is not binding. We will get back to you and confirm it.</p>
                        </div>

                        <t t-if="not orders_open">
                            <div class="gl-rz-closed">
                                <h3>Delivery is paused right now.</h3>
                                <!-- When the clock closed the page rather than
                                     the switch, say when to come back instead
                                     of only that it is shut. -->
                                <p t-if="hours_note" t-out="hours_note">
                                    We take orders 11:00 – 20:00.
                                </p>
                                <p>
                                    Please drop by the gelateria at Sokolovská 101 in Rybáře,
                                    or call us on <a href="tel:+420773095809">+420 773 09 58 09</a>.
                                </p>
                            </div>
                        </t>

                        <t t-else="">
                            <t t-set="bundles" t-value="addons.filtered('is_bundle')"/>
                            <t t-set="extras" t-value="addons - bundles"/>

                            <form class="gl-rz-form" id="gelatoRozvozForm"
                                  action="/rozvoz/objednat" method="post">

                                <!-- ===== 1: thermal boxes =====
                                     A row that swipes sideways rather than a
                                     stack: on a phone three stacked cards
                                     were a screen each. Tap one and it asks
                                     which flavours go in. -->
                                <div class="gl-rz-step-label" id="termoboxy">
                                    Thermal boxes
                                    <!-- On a phone the next card only peeks
                                         out at the edge, which is easy to
                                         read as the end of the list. Said
                                         once per row, and only where the row
                                         really does scroll. -->
                                    <span class="gl-swipe">
                                        Swipe
                                        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
                                            <path d="M5 12h14M13 6l6 6-6 6"/>
                                        </svg>
                                    </span>
                                </div>
                                <div class="gl-slider">
                                    <t t-foreach="boxes" t-as="box">
                                        <button type="button" class="gl-card gl-card-box"
                                                data-kind="box"
                                                t-att-data-note="box.subtitle or ''"
                                                t-att-data-id="box.id"
                                                t-att-data-price="box.price"
                                                t-att-data-parts="box.max_flavors"
                                                t-att-data-name="box.name">
                                            <span class="gl-card-photo">
                                                <img t-if="box.image"
                                                     t-att-src="website.image_url(box, 'image', &quot;400x300&quot;)"
                                                     t-att-style="box.image_style()"
                                                     t-att-alt="box.name" loading="lazy"/>
                                                <span t-else="" class="gl-card-photo-empty" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" width="34" height="34">
                                                        <path d="M4 8h16l-1.5 11a2 2 0 0 1-2 1.8H7.5a2 2 0 0 1-2-1.8L4 8Z"/>
                                                        <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
                                                    </svg>
                                                </span>
                                                <span t-if="box.highlight" class="gl-card-tag"
                                                      t-field="box.highlight_label">Most popular</span>
                                            </span>
                                            <span class="gl-card-name" t-field="box.name">1 l</span>
                                            <span class="gl-card-sub">
                                                <t t-if="box.subtitle"><t t-out="box.subtitle"/></t>
                                                <t t-if="box.subtitle and box.max_flavors"> · </t>
                                                <t t-if="box.max_flavors"><t t-out="box.flavor_limit_short()"/></t>
                                            </span>
                                            <span class="gl-card-foot">
                                                <span class="gl-card-price"><t t-out="int(box.price)">450</t> Kč</span>
                                                <span class="gl-card-cta">Choose</span>
                                            </span>
                                        </button>
                                    </t>
                                </div>

                                <!-- ===== 2: bundles ===== -->
                                <t t-if="bundles">
                                    <div class="gl-rz-step-label" id="balicky">
                                        Bundles at a better price
                                        <span class="gl-swipe">
                                            Swipe
                                            <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
                                                <path d="M5 12h14M13 6l6 6-6 6"/>
                                            </svg>
                                        </span>
                                    </div>
                                    <div class="gl-slider">
                                        <t t-foreach="bundles" t-as="addon">
                                            <button type="button" class="gl-card gl-card-bundle"
                                                    data-kind="addon"
                                                    t-att-data-note="addon.description or ''"
                                                    t-att-data-id="addon.id"
                                                    t-att-data-price="addon.display_price()"
                                                    t-att-data-parts="addon.bundle_box_id.max_flavors"
                                                    t-att-data-max="addon.max_quantity or 10"
                                                    t-att-data-name="addon.name">
                                                <span class="gl-card-photo">
                                                    <img t-if="addon.image"
                                                         t-att-src="website.image_url(addon, 'image', &quot;400x300&quot;)"
                                                         t-att-style="addon.image_style()"
                                                         t-att-alt="addon.name" loading="lazy"/>
                                                    <span t-else="" class="gl-card-photo-empty" aria-hidden="true">
                                                        <svg viewBox="0 0 24 24" width="34" height="34">
                                                            <path d="M8 2h8l-1 6a4 4 0 0 1-6 0L8 2Z"/>
                                                            <path d="M12 12v9M9 21h6"/>
                                                        </svg>
                                                    </span>
                                                </span>
                                                <span class="gl-card-name" t-field="addon.name">Dolce Vita</span>
                                                <span class="gl-card-sub">
                                                    <t t-if="addon.description"><t t-out="addon.description"/></t>
                                                </span>
                                                <span class="gl-card-foot">
                                                    <span class="gl-card-price"><t t-out="int(addon.display_price())">799</t> Kč</span>
                                                    <span class="gl-card-cta">Choose</span>
                                                </span>
                                            </button>
                                        </t>
                                    </div>
                                </t>

                                <!-- ===== 3: extras =====
                                     Nothing to fill here, so one tap puts a
                                     bottle straight in the order. -->
                                <t t-if="extras">
                                    <div class="gl-rz-step-label" id="doplnky">
                                        Extras
                                        <span class="gl-swipe">
                                            Swipe
                                            <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
                                                <path d="M5 12h14M13 6l6 6-6 6"/>
                                            </svg>
                                        </span>
                                    </div>
                                    <div class="gl-slider">
                                        <t t-foreach="extras" t-as="addon">
                                            <button type="button" class="gl-card gl-card-extra"
                                                    data-kind="addon"
                                                    t-att-data-note="addon.description or ''"
                                                    t-att-data-id="addon.id"
                                                    t-att-data-price="addon.display_price()"
                                                    data-parts="0"
                                                    t-att-data-max="addon.max_quantity or 10"
                                                    t-att-data-name="addon.name">
                                                <span class="gl-card-photo">
                                                    <img t-if="addon.image"
                                                         t-att-src="website.image_url(addon, 'image', &quot;400x300&quot;)"
                                                         t-att-style="addon.image_style()"
                                                         t-att-alt="addon.name" loading="lazy"/>
                                                    <span t-else="" class="gl-card-photo-empty" aria-hidden="true">
                                                        <svg viewBox="0 0 24 24" width="34" height="34">
                                                            <path d="M8 2h8l-1 6a4 4 0 0 1-6 0L8 2Z"/>
                                                            <path d="M12 12v9M9 21h6"/>
                                                        </svg>
                                                    </span>
                                                </span>
                                                <span class="gl-card-name" t-field="addon.name">Prosecco</span>
                                                <span class="gl-card-sub">
                                                    <t t-if="addon.description"><t t-out="addon.description"/></t>
                                                </span>
                                                <span class="gl-card-foot">
                                                    <span class="gl-card-price"><t t-out="int(addon.display_price())">429</t> Kč</span>
                                                    <span class="gl-card-cta">Add</span>
                                                </span>
                                            </button>
                                        </t>
                                    </div>
                                </t>

                                <!-- ===== filling a box =====
                                     One panel serves every product; it opens
                                     under whichever card was tapped. -->
                                <div class="gl-panel" id="gelatoPanel" hidden="hidden">
                                    <div class="gl-panel-backdrop" id="gelatoPanelBackdrop"></div>
                                    <div class="gl-panel-card">
                                        <button type="button" class="gl-panel-close" id="gelatoPanelClose"
                                                aria-label="Close">&#215;</button>
                                        <!-- The picture of whatever was tapped, copied
                                             across from its card so the customer sees
                                             what they are filling. -->
                                        <div class="gl-panel-photo" id="gelatoPanelPhoto"></div>
                                        <div class="gl-panel-body">
                                    <div class="gl-panel-head">
                                        <span class="gl-panel-name" id="gelatoPanelName">1 l</span>
                                        <span class="gl-panel-price" id="gelatoPanelPrice">450 Kč</span>
                                    </div>
                                    <!-- What this one actually is. On the card
                                         the line is clipped to keep the row
                                         short; here there is room for it. -->
                                    <p class="gl-panel-note" id="gelatoPanelNote" hidden="hidden"></p>

                                    <t t-if="flavors">
                                        <!-- The flavours are the screen, not a drawer
                                             inside it. They used to sit behind an
                                             "Add a flavour" button and shut again after
                                             every pick, so filling a box for four meant
                                             opening the same list four times and
                                             scrolling back down to it each time.
                                             Tapping a flavour now puts one in the box
                                             and leaves the list exactly where it was. -->
                                        <div class="gl-picker" id="gelatoPicker">
                                            <t t-foreach="flavors_by_category" t-as="group">
                                                <div class="gl-picker-group" t-out="group['name']">Ice creams</div>
                                                <t t-foreach="group['flavors']" t-as="flavor">
                                                    <div class="gl-opt-row"
                                                         t-att-data-flavor-id="flavor.id"
                                                         t-att-data-flavor-name="flavor.name">
                                                        <button type="button" class="gl-opt"
                                                                t-att-data-flavor-id="flavor.id"
                                                                t-att-data-flavor-name="flavor.name">
                                                            <span class="gl-opt-photo">
                                                                <img t-if="flavor.image"
                                                                     t-att-src="website.image_url(flavor, 'image', &quot;96x96&quot;)"
                                                                     t-att-alt="flavor.name" loading="lazy"/>
                                                                <span t-else="" class="gl-opt-dot"
                                                                      t-attf-style="background: #{flavor.display_color};"
                                                                      aria-hidden="true"></span>
                                                            </span>
                                                            <!-- The tags sit under the name, not beside
                                                                 it: next to a long name they squeezed it
                                                                 into two lines and ran across it. -->
                                                            <span class="gl-opt-text">
                                                                <span class="gl-opt-name" t-field="flavor.name">Vanilla</span>
                                                                <span class="gl-opt-sub">
                                                                    <t t-if="flavor.allergens">
                                                                        Allergens: <t t-out="flavor.allergens">milk</t>
                                                                    </t>
                                                                    <t t-foreach="flavor.tag_ids" t-as="tag">
                                                                        <span class="gl-rz-tag-mini"
                                                                              t-attf-style="color: #{tag.color or '#84c5c3'}; border-color: #{tag.color or '#84c5c3'};"
                                                                              t-field="tag.name">vegan</span>
                                                                    </t>
                                                                </span>
                                                            </span>
                                                        </button>
                                                        <!-- Appears on the first tap and stays
                                                             put: one portion in the box, plus
                                                             and minus right beside it. -->
                                                        <span class="gl-qty gl-opt-qty" hidden="hidden">
                                                            <button type="button" class="gl-qty-btn gl-row-minus"
                                                                    aria-label="One portion less">−</button>
                                                            <span class="gl-qty-value">1</span>
                                                            <button type="button" class="gl-qty-btn gl-row-plus"
                                                                    aria-label="One portion more">+</button>
                                                        </span>
                                                    </div>
                                                </t>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="gl-rz-empty">
                                            We have not posted today's line-up yet. Call us on
                                            <a href="tel:+420773095809">+420 773 09 58 09</a> and we will
                                            tell you what is ready.
                                        </p>
                                    </t>
                                        </div>

                                        <!-- Sits still while the flavours scroll under
                                             it. How much of the box is still free and
                                             the way out of here are the two things the
                                             customer looks for, and neither should have
                                             to be scrolled to. -->
                                        <div class="gl-panel-foot" t-if="flavors">
                                            <p class="gl-rz-hint" id="gelatoPartsHint"></p>
                                            <button type="button" class="gl-rz-btn gl-rz-btn-primary gl-panel-add"
                                                    id="gelatoAddToCart">Put in the order</button>
                                        </div>
                                    </div>
                                </div>

                                <!-- ===== the basket, reachable from anywhere =====
                                     The order is listed at the bottom of a long
                                     page, so once a few things are in it there
                                     is no way to check what without scrolling
                                     past everything. This goes up into the
                                     header instead. It is there from the start,
                                     empty, so the customer knows where the
                                     order will be before there is one.

                                     It is written here as a list item because
                                     the script moves it into the header's own
                                     row of buttons on load. Being part of the
                                     header is the whole point: it then slides,
                                     hides and gets covered along with it, with
                                     nothing to keep in step. -->
                                <li class="nav-item gl-cartbar">
                                    <button type="button" class="gl-cartbtn"
                                            aria-label="Your order">
                                        <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
                                            <path d="M3 3h2.2l2.1 10.4a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L20.5 7H6"/>
                                            <circle cx="10" cy="19.5" r="1.3"/>
                                            <circle cx="17" cy="19.5" r="1.3"/>
                                        </svg>
                                        <span class="gl-cartbtn-count js-cart-things">0</span>
                                    </button>
                                </li>

                                <div class="gl-drawer" id="gelatoCartDrawer" hidden="hidden">
                                    <div class="gl-drawer-backdrop" id="gelatoDrawerBackdrop"></div>
                                    <div class="gl-drawer-card">
                                        <div class="gl-drawer-head">
                                            <h3>Your order</h3>
                                            <button type="button" class="gl-drawer-close"
                                                    id="gelatoDrawerClose" aria-label="Close">&#215;</button>
                                        </div>
                                        <div class="gl-cart gl-cart-list" id="gelatoDrawerCart"></div>
                                        <p class="gl-rz-empty gl-drawer-empty" id="gelatoDrawerEmpty">
                                            Nothing in it yet. Pick a box above.
                                        </p>
                                        <div class="gl-drawer-foot">
                                            <span class="gl-cart-sum">
                                                <span class="js-cart-count"></span>
                                                <span class="js-cart-total">0</span> Kč
                                            </span>
                                            <button type="button" class="gl-rz-btn gl-rz-btn-primary"
                                                    id="gelatoDrawerContinue">Continue</button>
                                        </div>
                                    </div>
                                </div>

                                <!-- ===== on to the form =====
                                     Only the running total here. The list of
                                     what was picked is spelled out at the very
                                     end, above the button that orders it, and
                                     twice on one page is once too many. -->
                                <p class="gl-rz-empty" id="gelatoCartEmpty">
                                    Nothing in it yet. Pick a box above.
                                </p>
                                <div class="gl-cart-foot" id="gelatoCartFoot" hidden="hidden">
                                    <button type="button" class="gl-rz-btn gl-rz-btn-primary"
                                            id="gelatoContinue">Continue</button>
                                </div>

                                <!-- ===== who and where =====
                                     Held back until there is something in the
                                     basket: an empty form above an empty order
                                     is just a wall of boxes to fill in. -->
                                <div class="gl-checkout" id="gelatoCheckout" hidden="hidden">
                                    <div class="gl-rz-step-label">Who to call</div>
                                    <div class="gl-rz-row">
                                        <div class="gl-rz-field">
                                            <label for="gelatoName">Your name *</label>
                                            <input type="text" id="gelatoName" name="customer_name"
                                                   placeholder="Jan Novák" required="required"/>
                                        </div>
                                        <div class="gl-rz-field">
                                            <label for="gelatoPhone">Phone *</label>
                                            <input type="tel" id="gelatoPhone" name="customer_phone"
                                                   placeholder="+420 773 09 58 09" required="required"/>
                                        </div>
                                    </div>
                                    <div class="gl-rz-field">
                                        <label for="gelatoEmail">Email *</label>
                                        <input type="email" id="gelatoEmail" name="customer_email"
                                               placeholder="jan@email.cz" required="required"/>
                                        <p class="gl-rz-hint">We send the order confirmation here.</p>
                                    </div>

                                    <div class="gl-rz-step-label">Where to bring it</div>
                                    <div class="gl-rz-field">
                                        <label for="gelatoAddress">Delivery address *</label>
                                        <input type="text" id="gelatoAddress" name="delivery_address"
                                               placeholder="Street and number, floor, doorbell" required="required"/>
                                        <p class="gl-rz-hint" id="gelatoAddressHint"></p>
                                    </div>
                                    <div class="gl-rz-row">
                                        <div class="gl-rz-field">
                                            <label for="gelatoPostcode">Postcode</label>
                                            <input type="text" id="gelatoPostcode" name="delivery_postcode"
                                                   placeholder="360 05"
                                                   inputmode="numeric" autocomplete="postal-code"/>
                                        </div>
                                        <!-- Typed, not chosen. Most of it is Karlovy Vary,
                                             but the villages around it are not, and a list
                                             of one town told the customer they were in the
                                             wrong place. Where we actually drive is settled
                                             by the address on the map, not by this. -->
                                        <div class="gl-rz-field">
                                            <label for="gelatoCity">Town</label>
                                            <input type="text" id="gelatoCity" name="delivery_city"
                                                   placeholder="Karlovy Vary"
                                                   autocomplete="address-level2"/>
                                        </div>
                                    </div>

                                    <div class="gl-rz-field">
                                        <label for="gelatoNote">Anything we should know?</label>
                                        <textarea id="gelatoNote" name="note" rows="3"
                                                  placeholder="Allergies, which bell to ring, anything else..."></textarea>
                                    </div>

                                    <div class="gl-rz-field">
                                        <label for="gelatoPromo">Promo code</label>
                                        <p t-if="promo_note" class="gl-rz-hint" t-out="promo_note">Got a code from Instagram?</p>
                                        <div class="gl-rz-promo">
                                            <input type="text" id="gelatoPromo" name="promo_code" placeholder="Your code"/>
                                            <button type="button" id="gelatoPromoBtn" class="gl-rz-btn gl-rz-btn-ghost">Apply</button>
                                        </div>
                                        <p class="gl-rz-hint" id="gelatoPromoHint"></p>
                                    </div>

                                    <!-- Every line spelled out on the same screen
                                         as the button that orders it, and still
                                         editable - this is the only place the
                                         basket is listed. -->
                                    <div class="gl-rz-step-label" id="kosik">Your order</div>
                                    <div class="gl-cart gl-cart-list" id="gelatoCart"></div>

                                    <div class="gl-rz-summary">
                                        <div class="gl-rz-summary-row">
                                            <span>Subtotal</span>
                                            <span><span id="gelatoSubtotal">0</span> Kč</span>
                                        </div>
                                        <div class="gl-rz-summary-row" id="gelatoDiscountRow" hidden="hidden">
                                            <span>Discount</span>
                                            <span>&#8722;<span id="gelatoDiscount">0</span> Kč</span>
                                        </div>
                                        <div class="gl-rz-summary-row">
                                            <span>Delivery</span>
                                            <span><span id="gelatoShipping">0</span> Kč</span>
                                        </div>
                                        <div class="gl-rz-summary-row gl-rz-summary-total">
                                            <span>Total</span>
                                            <strong><span id="gelatoTotal">0</span> Kč</strong>
                                        </div>
                                        <p class="gl-rz-hint">
                                            We will confirm the price with you. You pay in cash when we hand it over.
                                        </p>
                                    </div>

                                    <p class="gl-rz-error" id="gelatoFormError" hidden="hidden"></p>
                                    <div class="gl-rz-submit">
                                        <button type="submit" class="gl-rz-btn gl-rz-btn-primary" id="gelatoSubmit">
                                            Send the order
                                        </button>
                                    </div>
                                </div>

                                <div class="gl-rz-config"
                                     id="gelatoConfig"
                                     t-att-data-fee="website.gelato_delivery_fee"
                                     t-att-data-free-from="website.gelato_delivery_free_from"
                                     t-att-data-fee-base="website.gelato_delivery_fee_base"
                                     hidden="hidden"></div>
                            </form>

                            <!-- The last thing the customer sees. It says the
                                 order arrived, what its number is, and that
                                 somebody will ring - nothing else is left to
                                 do here. -->
                            <div class="gl-rz-done" id="gelatoRozvozDone" hidden="hidden">
                                <div class="gl-rz-done-tick" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="34" height="34">
                                        <path d="M20 6 9 17l-5-5"/>
                                    </svg>
                                </div>
                                <h3>Thank you, we have your order!</h3>
                                <p class="gl-rz-done-ref">
                                    Order number
                                    <strong id="gelatoOrderRef">ROZ/2026/0001</strong>
                                </p>
                                <p>
                                    We will ring you shortly to confirm it. You pay in
                                    cash when we hand it over.
                                </p>
                                <p class="gl-rz-done-call">
                                    Anything to change? Call us on
                                    <a href="tel:+420773095809">+420 773 09 58 09</a>.
                                </p>

                                <!-- A way out. Without it the confirmation is
                                     a dead end: the order is placed, the form
                                     is gone, and the only thing left to do is
