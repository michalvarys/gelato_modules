<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Orders are a plain list. There is no board and no stages: the
         gelateria takes a handful of orders a day, rings everybody
         anyway, and columns to drag cards through would be ceremony
         around work that is already done on the phone.
         ============================================================ -->
    <record id="gelato_delivery_order_view_list" model="ir.ui.view">
        <field name="name">gelato.delivery.order.list</field>
        <field name="model">gelato.delivery.order</field>
        <field name="arch" type="xml">
            <list string="Delivery orders">
                <field name="name"/>
                <field name="create_date" string="Came in"/>
                <field name="customer_name"/>
                <field name="customer_phone" optional="show"/>
                <field name="delivery_address" optional="show"/>
                <field name="zone_id" optional="show"/>
                <field name="order_summary" string="What was ordered" width="320"/>
                <field name="note" optional="hide"/>
                <field name="delivery_fee" string="Delivery" optional="hide" sum="Delivery"/>
                <field name="amount_total" string="Total" sum="Total"/>
                <field name="customer_email" optional="hide"/>
                <field name="address_located" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="source" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="gelato_delivery_order_view_form" model="ir.ui.view">
        <field name="name">gelato.delivery.order.form</field>
        <field name="model">gelato.delivery.order</field>
        <field name="arch" type="xml">
            <form string="Delivery order">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <field name="customer_phone" widget="phone"/>
                            <field name="customer_email" widget="email"/>
                            <!-- Every order is filed under one person in
                                 Customers, matched on the phone and the
                                 email. That contact list is the point, so
                                 it is worth seeing from here. -->
                            <field name="customer_id" readonly="1"/>
                        </group>
                        <group string="Delivery">
                            <field name="delivery_address"/>
                            <field name="delivery_postcode"/>
                            <field name="delivery_city"/>
                            <field name="zone_id"/>
                            <field name="delivery_date"/>
                            <field name="address_located" invisible="1"/>
                            <div colspan="2" class="alert alert-warning mb-0"
                                 role="status" invisible="address_located">
                                The map was unreachable when this order came in,
                                so no zone set the price. Confirm the delivery
                                fee on the phone.
                            </div>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="status" invisible="not note">
                        <strong>Note from the customer:</strong>
                        <field name="note" readonly="1" nolabel="1" class="d-inline"/>
                    </div>

                    <separator string="What was ordered"/>
                    <!-- One line per thing in the basket. Open a line to see
                         which flavours went into that particular box. -->
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="box_id"/>
                            <field name="addon_id"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal" sum="Total"/>
                            <field name="label" string="With" readonly="1"/>
                        </list>
                        <form>
                            <group>
                                <group>
                                    <field name="box_id"/>
                                    <field name="addon_id"/>
                                </group>
                                <group>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                </group>
                            </group>
                            <field name="flavor_line_ids" string="Flavours">
                                <list editable="bottom">
                                    <field name="flavor_id"/>
                                    <field name="quantity" string="Parts"/>
                                </list>
                            </field>
                        </form>
                    </field>

                    <group class="oe_subtotal_footer">
                        <field name="amount_subtotal"/>
                        <field name="promo_code_id"/>
                        <field name="discount_percent"/>
                        <field name="amount_discount"/>
                        <field name="delivery_fee"/>
                        <field name="amount_total" class="oe_subtotal_footer_separator"/>
                    </group>

                    <notebook>
                        <page string="Notes" name="notes">
                            <group>
                                <field name="note" string="From the customer" readonly="1"/>
                                <field name="internal_note" string="Internal"/>
                            </group>
                        </page>
                        <page string="Origin" name="origin" groups="base.group_no_one">
                            <group>
                                <field name="source"/>
                                <field name="website_id"/>
                                <field name="latitude"/>
                                <field name="longitude"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="gelato_delivery_order_view_search" model="ir.ui.view">
        <field name="name">gelato.delivery.order.search</field>
        <field name="model">gelato.delivery.order</field>
        <field name="arch" type="xml">
            <search string="Delivery orders">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="delivery_address"/>
                <field name="order_summary" string="What was ordered"/>
                <field name="flavor_ids" string="Flavour"/>
                <field name="zone_id"/>
                <filter name="filter_today" string="Today"
                        domain="[('delivery_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_week" string="Last seven days"
                        domain="[('delivery_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_unlocated" string="Address not on the map"
                        domain="[('address_located', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_date" string="Day" context="{'group_by': 'delivery_date'}"/>
                    <filter name="group_zone" string="Zone" context="{'group_by': 'zone_id'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'customer_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="gelato_delivery_order_list_action" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">gelato.delivery.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">No orders have come in yet.</p>
            <p>Every order from the delivery page lands here, with what was in it. Search by customer, address or flavour.</p>
        </field>
    </record>

</odoo>
