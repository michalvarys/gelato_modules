<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gelato_customer_view_list" model="ir.ui.view">
        <field name="name">gelato.customer.list</field>
        <field name="model">gelato.customer</field>
        <field name="arch" type="xml">
            <list string="Customers" multi_edit="1">
                <field name="name"/>
                <field name="phone" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="order_count" string="Orders"/>
                <field name="amount_spent" string="Spent" sum="Spent"/>
                <field name="last_order_date" string="Last order"/>
                <field name="zone_id" string="Zone" optional="show"/>
                <field name="last_address" optional="hide"/>
                <field name="first_order_date" optional="hide"/>
                <field name="marketing_ok" widget="boolean_toggle" string="May be contacted"/>
            </list>
        </field>
    </record>

    <record id="gelato_customer_view_form" model="ir.ui.view">
        <field name="name">gelato.customer.form</field>
        <field name="model">gelato.customer</field>
        <field name="arch" type="xml">
            <form string="Customer">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-basket">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Jan Novák"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="marketing_ok"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="History">
                            <field name="amount_spent"/>
                            <field name="first_order_date"/>
                            <field name="last_order_date"/>
                            <field name="last_address"/>
                            <field name="zone_id"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        This row was built from the orders. A returning customer is
                        matched on the phone number first and the email second, so
                        the same person never ends up here twice.
                        <br/>
                        Having somebody's address here is <b>not</b> the same as
                        them agreeing to hear from you. Tick
                        <b>May be contacted</b> only for those who did.
                    </div>
                    <notebook>
                        <page string="Orders" name="orders">
                            <field name="order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="delivery_date"/>
                                    <field name="delivery_address"/>
                                    <field name="order_summary" string="What was ordered"/>
                                    <field name="amount_total" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" nolabel="1" placeholder="Anything worth remembering about this customer..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gelato_customer_view_search" model="ir.ui.view">
        <field name="name">gelato.customer.search</field>
        <field name="model">gelato.customer</field>
        <field name="arch" type="xml">
            <search string="Customers">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="last_address"/>
                <filter name="filter_marketing" string="May be contacted"
                        domain="[('marketing_ok', '=', True)]"/>
                <filter name="filter_has_email" string="Has an email"
                        domain="[('email', '!=', False)]"/>
                <separator/>
                <filter name="filter_repeat" string="Ordered more than once"
                        domain="[('order_count', '&gt;', 1)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_zone" string="Zone" context="{'group_by': 'zone_id'}"/>
                    <filter name="group_last" string="Last order" context="{'group_by': 'last_order_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="gelato_customer_action" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">gelato.customer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">No customers yet.</p>
            <p>Every delivery order adds the person who placed it here, once. Nothing to fill in by hand.</p>
        </field>
    </record>

</odoo>
