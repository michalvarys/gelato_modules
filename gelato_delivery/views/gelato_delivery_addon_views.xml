<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gelato_delivery_addon_view_list" model="ir.ui.view">
        <field name="name">gelato.delivery.addon.list</field>
        <field name="model">gelato.delivery.addon</field>
        <field name="arch" type="xml">
            <list string="Extras">
                <field name="sequence" widget="handle"/>
                <field name="active" widget="boolean_toggle" string="Available"/>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="kind" optional="hide"/>
                <field name="bundle_box_id" string="With box" optional="show"/>
                <field name="bundle_total" string="Bundle price" optional="show"/>
                <field name="price" string="Surcharge"/>
                <field name="max_quantity" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="gelato_delivery_addon_view_form" model="ir.ui.view">
        <field name="name">gelato.delivery.addon.form</field>
        <field name="model">gelato.delivery.addon</field>
        <field name="arch" type="xml">
            <form string="Extra">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <field name="is_bundle" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="For example Eggnog"/>
                        </h1>
                        <field name="description" placeholder="One sentence for the website..."/>
                    </div>
                    <div class="o_row mt-3">
                        <field name="active" widget="boolean_toggle"/>
                        <label for="active" string="Available on the website"/>
                    </div>
                    <group>
                        <!-- Which list this lands in comes from the menu it
                             was created under, so the type is not a question
                             worth asking again on every record. -->
                        <field name="kind" invisible="1"/>
                        <group string="Price">
                            <field name="price_extra" invisible="kind == 'bundle'" required="kind != 'bundle'"/>
                            <field name="bundle_box_id" invisible="kind != 'bundle'" required="kind == 'bundle'"/>
                            <field name="bundle_total" invisible="kind != 'bundle'" required="kind == 'bundle'"/>
                            <field name="price" invisible="kind != 'bundle'"/>
                        </group>
                        <group string="On the website">
                            <field name="image_fit" invisible="not image"/>
                            <field name="image_focus"
                                   invisible="not image or image_fit != 'cover'"/>
                            <field name="sequence"/>
                            <field name="max_quantity"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="kind == 'bundle'">
                        Do not delete an extra when its season ends. Just switch
                        <b>Available on the website</b> off and it disappears from the site.
                        When its time comes, switch it back on and it is visible again.
                    </div>
                    <div class="alert alert-info" role="status" invisible="kind != 'bundle'">
                        For a bundle, fill in the <b>total price including the thermal box</b> -
                        the one on your leaflet. Odoo works out the <b>surcharge</b> itself and
                        recalculates it whenever you change the box price, so you never have to
                        think about it.
                        <br/>
                        The customer fills a bundle with flavours the same way as the box above.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gelato_delivery_addon_view_search" model="ir.ui.view">
        <field name="name">gelato.delivery.addon.search</field>
        <field name="model">gelato.delivery.addon</field>
        <field name="arch" type="xml">
            <search string="Extras">
                <field name="name"/>
                <filter name="filter_active" string="Available" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Switched off (out of season)" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_bundle" string="Bundles" domain="[('kind', '=', 'bundle')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="gelato_delivery_addon_action" model="ir.actions.act_window">
        <field name="name">Extras</field>
        <field name="res_model">gelato.delivery.addon</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kind', '!=', 'bundle')]</field>
        <field name="context">{'active_test': False, 'default_kind': 'drink'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Create your first extra.</p>
            <p>An extra is a bottle of prosecco or anything else that goes into an order on its own, with no flavours to pick. It shows in the <b>Extras</b> row on the delivery page. The <b>Available</b> switch turns it on and off.</p>
        </field>
    </record>

    <!-- The delivery page has three rows of products, so the back office
         has the same three lists. One model behind two of them: a bundle
         is an extra that brings a thermal box with it. -->
    <record id="gelato_delivery_bundle_action" model="ir.actions.act_window">
        <field name="name">Bundles</field>
        <field name="res_model">gelato.delivery.addon</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kind', '=', 'bundle')]</field>
        <field name="context">{'active_test': False, 'default_kind': 'bundle'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Create your first bundle.</p>
            <p>A bundle is a thermal box and a bottle together for one better price. It shows in the <b>Bundles at a better price</b> row on the delivery page, and the customer fills it with flavours just like a box.</p>
        </field>
    </record>

</odoo>
