<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gelato_delivery_box_view_list" model="ir.ui.view">
        <field name="name">gelato.delivery.box.list</field>
        <field name="model">gelato.delivery.box</field>
        <field name="arch" type="xml">
            <!-- Not an editable list on purpose: clicking a row used to
                 edit it in place, so the form with the photo never opened
                 and a thermal box could not be given a picture. A click
                 opens the box, the same as a bundle or an extra. -->
            <list string="Thermal boxes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="subtitle"/>
                <field name="price"/>
                <field name="max_flavors"/>
                <field name="highlight" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="gelato_delivery_box_view_form" model="ir.ui.view">
        <field name="name">gelato.delivery.box.form</field>
        <field name="model">gelato.delivery.box</field>
        <field name="arch" type="xml">
            <form string="Thermal box">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <!-- The photo sits where it does on an extra: top right,
                         click the frame and pick a file. Tucked into a group
                         further down it was a field nobody found. -->
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="For example 1 l"/>
                        </h1>
                        <field name="subtitle" placeholder="about 8 servings"/>
                    </div>
                    <group>
                        <!-- Only what the delivery page actually shows. The
                             volume, the servings count and the bullet points
                             are still on the record but off the form: nobody
                             fills them in and nothing reads them. -->
                        <group string="Price and contents">
                            <field name="price"/>
                            <field name="max_flavors"/>
                            <field name="flavor_note"/>
                        </group>
                        <group string="On the website">
                            <field name="image_fit" invisible="not image"/>
                            <field name="image_focus"
                                   invisible="not image or image_fit != 'cover'"/>
                            <field name="sequence"/>
                            <field name="highlight" widget="boolean_toggle"/>
                            <field name="highlight_label" invisible="not highlight"
                                   placeholder="Most popular"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gelato_delivery_box_action" model="ir.actions.act_window">
        <field name="name">Thermal boxes</field>
        <field name="res_model">gelato.delivery.box</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Create your first thermal box.</p>
            <p>Thermal boxes are what the customer picks on the delivery page. Prices and bullet points are changed here, not in the website code.</p>
        </field>
    </record>

</odoo>
