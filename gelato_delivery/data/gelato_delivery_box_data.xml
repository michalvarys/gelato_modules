<?xml version="1.0" encoding="utf-8"?>
<!--
    Thermal boxes, matching the price list in the shop.
    noupdate="1" - a module upgrade will not overwrite the prices, they are
    managed in Odoo.
-->
<odoo noupdate="1">

    <record id="box_05" model="gelato.delivery.box">
        <field name="name">0.5 l</field>
        <field name="subtitle">about 4 servings</field>
        <field name="price">250</field>
        <field name="volume_l">0.5</field>
        <field name="portions">4</field>
        <field name="max_flavors">2</field>
        <field name="sequence">10</field>
        <field name="features">Just enough for two
Pick up to 2 flavours
The box stays cold for about 2 hours</field>
    </record>

    <record id="box_1" model="gelato.delivery.box">
        <field name="name">1 l</field>
        <field name="subtitle">about 8 servings</field>
        <field name="price">450</field>
        <field name="volume_l">1.0</field>
        <field name="portions">8</field>
        <field name="max_flavors">4</field>
        <field name="sequence">20</field>
        <field name="highlight" eval="True"/>
        <field name="highlight_label">Most popular</field>
        <field name="features">Right for a family or a small gathering
Pick up to 4 flavours
The box stays cold for about 2 hours</field>
    </record>

    <record id="box_15" model="gelato.delivery.box">
        <field name="name">1.5 l</field>
        <field name="subtitle">about 12 servings</field>
        <field name="price">580</field>
        <field name="volume_l">1.5</field>
        <field name="portions">12</field>
        <field name="max_flavors">5</field>
        <field name="sequence">30</field>
        <field name="features">For a party or a company event
Pick up to 5 flavours
The box stays cold for about 2 hours</field>
    </record>

</odoo>
