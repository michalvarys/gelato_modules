<?xml version="1.0" encoding="utf-8"?>
<!--
    Two zones to start from, so the map is not empty on the first day.

    REDRAW THESE BEFORE GOING LIVE. The outlines are rough rings around
    Karlovy Vary, good enough to show how it works and nothing more. Open
    each zone, press Draw a zone and click the real edge of where you drive.

    No zones at all means no checking: every address goes through and pays
    the flat fee from the settings.
-->
<odoo noupdate="1">

    <record id="zone_kv_mesto" model="gelato.delivery.zone">
        <field name="name">Karlovy Vary - town</field>
        <field name="sequence">10</field>
        <field name="delivery_fee">79</field>
        <field name="free_from">800</field>
        <field name="color">#84c5c3</field>
        <field name="polygon">[[50.2620,12.8300],[50.2580,12.8720],[50.2540,12.8960],[50.2390,12.9120],[50.2240,12.9020],[50.2120,12.8830],[50.2060,12.8520],[50.2150,12.8180],[50.2330,12.8020],[50.2500,12.8060]]</field>
    </record>

    <record id="zone_kv_okoli" model="gelato.delivery.zone">
        <field name="name">Around the town</field>
        <field name="sequence">20</field>
        <field name="delivery_fee">129</field>
        <field name="free_from">1500</field>
        <field name="min_order">500</field>
        <field name="color">#c8891b</field>
        <field name="polygon">[[50.2900,12.7900],[50.2850,12.9300],[50.2500,12.9700],[50.2100,12.9600],[50.1850,12.9000],[50.1800,12.8200],[50.2050,12.7600],[50.2600,12.7500]]</field>
    </record>

</odoo>
