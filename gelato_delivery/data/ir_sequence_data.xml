<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Jediné místo v modulech psané rovnou česky.

        `ir.sequence.name` není v Odoo přeložitelné pole, takže anglický název
        by v Nastavení -> Technické -> Sekvence zůstal anglicky napořád a
        nikomu by neposloužil. Zbytek modulů je anglicky a čeština se řeší
        překladem v i18n/cs.po - viz README.
    -->
    <record id="seq_gelato_delivery_order" model="ir.sequence">
        <field name="name">Číslování objednávek rozvozu</field>
        <field name="code">gelato.delivery.order</field>
        <field name="prefix">ROZ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
