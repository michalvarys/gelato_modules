<?xml version="1.0" encoding="utf-8"?>
<!--
    Delivery extras - the bottles and bundles that can be added to an order.

    Everything here comes from the real order form on gelatokv.cz. Do not
    invent products: a flavour of gelato belongs in gelato_flavors, not here.
    Eggnog, for instance, is a flavour - it is not sold as a bottle.

    Bundles store the TOTAL price (bundle_total) and the box they go with.
    The surcharge added to the order is derived from those two, so it can
    never drift away from the box price.
-->
<odoo noupdate="1">

    <record id="addon_prosecco" model="gelato.delivery.addon">
        <field name="name">Prosecco Le Colture Fagher</field>
        <field name="description">Valdobbiadene Prosecco Superiore DOCG, 0.75 l.</field>
        <field name="price_extra">429</field>
        <field name="kind">drink</field>
        <field name="max_quantity">6</field>
        <field name="sequence">10</field>
    </record>

    <record id="addon_bundle_dolce_vita" model="gelato.delivery.addon">
        <field name="name">Dolce Vita bundle</field>
        <field name="description">A 1 l thermal box and a bottle of prosecco at a better price.</field>
        <field name="kind">bundle</field>
        <field name="bundle_box_id" ref="box_1"/>
        <field name="bundle_total">799</field>
        <field name="max_quantity">4</field>
        <field name="sequence">20</field>
    </record>

    <record id="addon_bundle_festa" model="gelato.delivery.addon">
        <field name="name">Festa bundle</field>
        <field name="description">A 1.5 l thermal box and two bottles of prosecco at a better price.</field>
        <field name="kind">bundle</field>
        <field name="bundle_box_id" ref="box_15"/>
        <field name="bundle_total">1299</field>
        <field name="max_quantity">3</field>
        <field name="sequence">30</field>
    </record>

</odoo>
