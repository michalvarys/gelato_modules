<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gelato_delivery.ZoneMapField">
        <div class="o_gelato_zone_field">
            <div class="o_gelato_zone_tools">
                <button type="button"
                        class="btn btn-sm"
                        t-att-class="state.drawing ? 'btn-primary' : 'btn-secondary'"
                        t-on-click="onToggleDraw">
                    <i class="fa fa-pencil me-1" role="img"/>
                    <t t-esc="state.drawing ? labels.stop : labels.draw"/>
                </button>
                <button type="button" class="btn btn-sm btn-link text-danger"
                        t-on-click="onClear">
                    <i class="fa fa-trash-o me-1" role="img"/>
                    <t t-esc="labels.clear"/>
                </button>
                <span class="o_gelato_zone_count" t-esc="labels.count"/>
            </div>
            <div class="o_gelato_zone_map" t-ref="map"/>
            <p class="o_gelato_zone_hint">
                <t t-esc="state.points.length ? labels.hint : labels.empty"/>
            </p>
        </div>
    </t>

</templates>
