<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gelato_delivery.DeliverySwitch">
        <div t-if="state.loaded" class="o_gelato_switch"
             t-att-class="{ 'o_gelato_switch_off': !state.enabled }">
            <div class="o_gelato_switch_main">
                <span class="o_gelato_switch_title">Delivery service</span>
                <label class="o_gelato_switch_toggle" t-att-title="labels.toggle">
                    <input type="checkbox"
                           t-att-checked="state.enabled"
                           t-on-change="onToggle"/>
                    <span class="o_gelato_switch_slider"/>
                </label>
                <span class="o_gelato_switch_state" t-esc="statusLabel"/>

                <!-- The hours sit here rather than in Settings: whoever is
                     in the shop can move them without being let in there.
                     Each label is tied to its own box so the two can stack
                     on a phone instead of running off the edge. -->
                <span class="o_gelato_switch_hours">
                    <span class="o_gelato_switch_hour_field">
                        <label t-esc="labels.from"/>
                        <input type="text" class="o_gelato_switch_hour"
                               t-att-value="state.from"
                               t-on-change="(ev) => this.onHourChange('gelato_order_from', ev)"/>
                    </span>
                    <span class="o_gelato_switch_hour_field">
                        <label t-esc="labels.to"/>
                        <input type="text" class="o_gelato_switch_hour"
                               t-att-value="state.to"
                               t-on-change="(ev) => this.onHourChange('gelato_order_to', ev)"/>
                    </span>
                </span>
            </div>
        </div>
    </t>

    <t t-name="gelato_delivery.BoardWithSwitch" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <GelatoDeliverySwitch/>
        </xpath>
    </t>

</templates>
